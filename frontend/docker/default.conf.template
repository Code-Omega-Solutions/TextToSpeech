server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    access_log off;
    error_log /dev/stderr warn;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;

    client_max_body_size 16k;

    location = /api/healthz {
        proxy_pass ${TTS_UPSTREAM_URL}/healthz;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        proxy_set_header Connection "";
    }

    location = /api/readyz {
        proxy_pass ${TTS_UPSTREAM_URL}/readyz;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_set_header Connection "";
    }

    location = /api/v1/audio/speech {
        limit_except POST { deny all; }
        proxy_pass ${TTS_UPSTREAM_URL}/v1/audio/speech;
        proxy_connect_timeout 5s;
        proxy_read_timeout 75s;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_set_header Connection "";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
