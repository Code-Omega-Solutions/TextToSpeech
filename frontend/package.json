{
  "name": "private-speech-studio-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/config.test.js tests/dev.test.js",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "test:docker": "node --test tests/docker.test.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.5"
  }
}
