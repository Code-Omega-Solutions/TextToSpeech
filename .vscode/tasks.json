{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Spec Kit: Check Local Setup",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": ["${workspaceFolder}/checks/check_speckit_setup.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}