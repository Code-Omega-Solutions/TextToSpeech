{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "python3 .specify/extensions/companion/scripts/write-context.py --event user_prompt_submit",
        "powershell": "& 'python' '.specify/extensions/companion/scripts/write-context.py' '--event' 'user_prompt_submit'",
        "timeoutSec": 15,
        "__speckit_event__": true
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "python3 .specify/extensions/companion/scripts/write-context.py --event stop",
        "powershell": "& 'python' '.specify/extensions/companion/scripts/write-context.py' '--event' 'stop'",
        "timeoutSec": 15,
        "__speckit_event__": true
      }
    ]
  }
}