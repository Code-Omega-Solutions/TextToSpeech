# Required server-side speech-service origin, with no trailing slash.
# Replace this example with the authorized existing service.
TTS_UPSTREAM_URL=http://speech-service.example:8000

# Required server-side credential file. Create it outside the repository and
# restrict access to its owner (for example: chmod 600 /path/to/tts-api-key).
TTS_API_KEY_FILE=/absolute/path/to/protected/tts-api-key
